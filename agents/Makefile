AGENTS.md: agents-shared.md agents-shared.extra.md Makefile
	@set -eu; \
	trap 'rm -f "$@.tmp"' EXIT; \
	{ \
		printf '<!-- Generated by Makefile. Edit agents-shared.md or agents-shared.extra.md. -->\n\n'; \
		cat agents-shared.md; \
		printf '\n'; \
		cat agents-shared.extra.md; \
	} >"$@.tmp"; \
	mv "$@.tmp" "$@"
